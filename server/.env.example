# A long random shared secret the phone must send as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
# Leave it empty and the server binds to 127.0.0.1 only, so the phone cannot
# reach it - that is deliberate, not a bug.
AUTH_TOKEN=

# Failed token attempts from one client before it is locked out, the window
# they are counted over, and how long the lockout lasts. A correct token clears
# the count, so mistyping it in the app a few times does not lock you out.
AUTH_MAX_FAILURES=10
AUTH_WINDOW_MS=300000
AUTH_LOCKOUT_MS=300000

# Set to true ONLY when the server sits behind a proxy you control, such as a
# Cloudflare Tunnel, which is the only thing that can reach it. Then the rate
# limit counts real clients instead of treating the tunnel as one. Leave it
# false when the server is directly reachable, or anyone can forge the header.
TRUST_PROXY=false

# Port the API listens on
PORT=5090

# Where the SQLite file lives
DATABASE_FILE=./taste-radar.db

# Needed only by POST /wants, to compile free text into criteria.
# Without it the API falls back to a keyword extractor and says so in the response.
ANTHROPIC_API_KEY=

# Needed only by the place-refresh worker.
GOOGLE_PLACES_API_KEY=
